{
  "name": "blacktreeroofing",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "WATCHPACK_POLLING=true CHOKIDAR_USEPOLLING=true next dev --hostname 127.0.0.1 --port 3000",
    "dev:clean": "sh -c 'lsof -ti :3000 | xargs kill -9 2>/dev/null || true' && rm -rf .next && npm run dev",
    "dev:all": "WATCHPACK_POLLING=true CHOKIDAR_USEPOLLING=true next dev --hostname 0.0.0.0 --port 3000",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3000",
    "lint": "next lint",
    "push:github": "sh scripts/push-to-github.sh"
  },
  "dependencies": {
    "framer-motion": "^12.15.0",
    "lucide-react": "^0.511.0",
    "next": "^15.3.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "@types/react": "^19.1.4",
    "@types/react-dom": "^19.1.5",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.27.0",
    "eslint-config-next": "^15.3.3",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3"
  }
}
